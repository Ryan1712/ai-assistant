; Expo SDK 57 / RN 0.86: react-native khai báo peerOptional @react-native/jest-preset@0.86.0
; trong khi jest-expo@57 cần ^0.86.2 → npm strict fail ERESOLVE, làm hỏng/thiếu package
; (đã từng khiến react-native-worklets biến mất khỏi node_modules → build iOS lỗi
;  "WorkletsNetworking.mm couldn't be opened"). Chuẩn của Expo/RN là bật legacy-peer-deps.
legacy-peer-deps=true
