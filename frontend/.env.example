# URL backend FastAPI (mac dinh dev local)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Sentry DSN cho native crash reporting (ADR-003).
# Rong = Sentry khong khoi tao, app van chay binh thuong.
# Dev local: de trong (khong can Sentry khi phat trien).
# Preview/Production: dat gia tri thuc qua EAS Secret (xem README > Crash Reporting & Sentry).
#   eas secret:create --scope project --name EXPO_PUBLIC_SENTRY_DSN --value "https://..."
# Luu y: @sentry/react-native la native module — can build lai dev-client/EAS,
#         KHONG chay tren Expo Go.
EXPO_PUBLIC_SENTRY_DSN=
